<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Section Users: see public + assigned sections -->
        <record id="res_sections_user_rule" model="ir.rule">
            <field name="name">Sections: User Access</field>
            <field name="model_id" ref="model_res_sections"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('is_public', '=', True),
                ('assigned_user_ids', 'in', [user.id]),
                ('manager_id', '=', user.id),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_section_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Section Managers: full CRUD on their sections -->
        <record id="res_sections_manager_rule" model="ir.rule">
            <field name="name">Sections: Manager Modify</field>
            <field name="model_id" ref="model_res_sections"/>
            <field name="domain_force">[
                '|',
                ('manager_id', '=', user.id),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_section_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- System Admin: unrestricted -->
        <record id="res_sections_admin_rule" model="ir.rule">
            <field name="name">Sections: Admin Full Access</field>
            <field name="model_id" ref="model_res_sections"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>
