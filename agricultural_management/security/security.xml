<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!--  RECORD RULES: Production Requests                           -->
        <!-- ============================================================ -->

        <!-- Engineers can see all production requests -->
        <record id="rule_production_request_engineer" model="ir.rule">
            <field name="name">Production Request: Engineer Access</field>
            <field name="model_id" ref="model_agricultural_production_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_agricultural_engineer'))]"/>
        </record>

        <!-- Warehouse managers see approved requests -->
        <record id="rule_production_request_warehouse" model="ir.rule">
            <field name="name">Production Request: Warehouse Manager Access</field>
            <field name="model_id" ref="model_agricultural_production_request"/>
            <field name="domain_force">[('state', 'in', ['dr_approved', 'warehouse_approved', 'accounts_approved', 'done'])]</field>
            <field name="groups" eval="[(4, ref('group_inventory_manager'))]"/>
        </record>

        <!-- Accountants see warehouse-approved requests -->
        <record id="rule_production_request_accounts" model="ir.rule">
            <field name="name">Production Request: Accounts Access</field>
            <field name="model_id" ref="model_agricultural_production_request"/>
            <field name="domain_force">[('state', 'in', ['warehouse_approved', 'accounts_approved', 'done'])]</field>
            <field name="groups" eval="[(4, ref('group_accounts'))]"/>
        </record>

        <!-- Users can see their own requests -->
        <record id="rule_production_request_user" model="ir.rule">
            <field name="name">Production Request: Own Records</field>
            <field name="model_id" ref="model_agricultural_production_request"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_agricultural_user'))]"/>
        </record>

        <!-- ============================================================ -->
        <!--  RECORD RULES: Farms                                         -->
        <!-- ============================================================ -->

        <!-- Users can see active farms -->
        <record id="rule_farm_user" model="ir.rule">
            <field name="name">Farm: User Read Access</field>
            <field name="model_id" ref="model_agricultural_farm"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_agricultural_user'))]"/>
        </record>

        <!-- Managers have full farm access -->
        <record id="rule_farm_manager" model="ir.rule">
            <field name="name">Farm: Manager Full Access</field>
            <field name="model_id" ref="model_agricultural_farm"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_agricultural_manager'))]"/>
        </record>



    </data>
</odoo>
