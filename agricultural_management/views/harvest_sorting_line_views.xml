<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_harvest_sorting_line_list" model="ir.ui.view">
        <field name="name">harvest.sorting.line.list</field>
        <field name="model">harvest.sorting.line</field>
        <field name="arch" type="xml">
            <list string="Harvest Sorting Lines"
                  decoration-success="state=='done'"
                  decoration-info="state=='confirmed'"
                  decoration-muted="state=='cancel'"
                  decoration-warning="state=='draft'">

                <field name="name" string="Reference"/>
                <field name="date"/>
                <field name="harvest_batch_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="total_quantity"/>
                <field name="uom_id"/>
                <field name="grade"
                       decoration-success="grade=='a'"
                       decoration-info="grade=='b'"
                       decoration-warning="grade=='c'"
                       decoration-danger="grade=='rejected'"/>
                <field name="project_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state=='done'"
                       decoration-info="state in ('confirmed','sorted')"
                       decoration-warning="state=='draft'"
                       decoration-danger="state=='cancel'"/>
            </list>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_harvest_sorting_line_form" model="ir.ui.view">
        <field name="name">harvest.sorting.line.form</field>
        <field name="model">harvest.sorting.line</field>
        <field name="arch" type="xml">
            <form string="Harvest Sorting Line">
                <header>
                    <!-- Workflow Buttons -->
                    <button name="action_confirm" string="Confirm"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_sort" string="Process Sorting"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                <button name="action_open_wizard"
                        string="Sort by Grade"
                        type="object"
                        class="oe_highlight"/>
                <button name="action_confirm_sorting"
                        string="Confirm Sorting"
                        type="object"
                        class="oe_highlight"/>
                    <button name="action_done" string="Mark as Done"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ['done', 'cancel']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancel'"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,sorted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
 <group name="main_info" string="Sorting">
                            <field name="date"/>
                            <field name="harvest_batch_id"
                                   readonly="state != 'draft'"
                                   required="1"/>
                        </group>
 <group name="product_info" string="Product">
                            <field name="product_id"
                                   readonly="state != 'draft'"
                                   required="1"/>
                            <field name="quantity"
                                   readonly="state not in ['draft', 'confirmed']"/>
                            <field name="uom_id"
                                   readonly="state != 'draft'"/>
                            <field name="grade"/>
                            <field name="size_category" />
                            <field name="initial_weight"/>
                            <field name="final_weight"/>
                            <field name="waste_weight"/>
                            <field name="waste_percentage"/>
                            <field name="product_variant_id"/>
                        </group>
                    </group>
                    <group>
 <group name="accounting" string="Accounts Project">
                            <field name="analytic_account_id"
                                   readonly="state not in ['draft', 'confirmed']"/>
                            <field name="project_id"
                                   readonly="state not in ['draft', 'confirmed']"/>
                        </group>
                    </group>

 <group name="integration" string="Inventory">
                        <group>
                            <field name="picking_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="...... Notes ...."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Wizard Form View -->
    <!-- Actions -->
    <record id="action_harvest_sorting_line" model="ir.actions.act_window">
 <field name="name"> </field>
        <field name="res_model">harvest.sorting.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_this_month': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Harvest Sorting Line
            </p>
            <p>
                Track and manage harvest sorting by quality grades.
            </p>
        </field>
    </record>
    <record id="action_harvest_sorting_wizard" model="ir.actions.act_window">
        <field name="name">Sorting Wizard</field>
        <field name="res_model">harvest.sorting.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <!-- Menu Items -->
    <menuitem id="menu_harvest_sorting_line"
 name=""
              parent="agricultural_management.menu_agricultural_operations"
              action="action_harvest_sorting_line"
              sequence="50"/>
</odoo>