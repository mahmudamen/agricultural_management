<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_harvest_batch_list" model="ir.ui.view">
        <field name="name">harvest.batch.list</field>
        <field name="model">harvest.batch</field>
        <field name="arch" type="xml">
            <list string="Harvest Batches"
                  decoration-info="state in ('draft','collection')"
                  decoration-success="state == 'approved'"
                  decoration-warning="state in ('collected','sorting','quality')"
                  decoration-primary="state == 'sorted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'"
                  sample="1">

                <field name="name" string="Batch Number"/>
                <field name="batch_date"/>
                <field name="schedule_id"/>
                <field name="project_id" optional="show"/>
                <field name="farm_id" optional="hide"/>
                <field name="crop_id" optional="show"/>

                <!-- Quantities -->
                <field name="estimated_quantity" optional="hide"/>
                <field name="actual_quantity" sum="actual" string="Collected" widget="float"/>
                <field name="total_weight" sum="total" string="Total (kg)" widget="float" decoration-bf="1"/>
                <field name="sorted_weight" sum="sorted" string="Sorted (kg)" widget="float"/>
                <field name="waste_weight" sum="waste" string="Waste (kg)" widget="float" optional="hide"/>
                <field name="waste_percentage" string="Waste %" widget="percentage" optional="show"
                       decoration-danger="waste_percentage &gt; 20"
                       decoration-warning="waste_percentage &gt; 10"/>
                <field name="uom_id" optional="hide"/>

                <!-- Lots -->
                <field name="lot_count" optional="show"/>
                <field name="sorting_line_count" optional="show"/>

                <!-- Financial -->
                <field name="currency_id" invisible="1"/>
                <field name="batch_revenue" sum="revenue" string="Revenue" widget="monetary" optional="hide"/>
                <field name="batch_cost" sum="cost" string="Cost" widget="monetary" optional="hide"/>
                <field name="batch_profit" sum="profit" string="Profit" widget="monetary" optional="show"
                       decoration-success="batch_profit &gt; 0"
                       decoration-danger="batch_profit &lt; 0"/>
                <field name="profit_margin" widget="percentage" optional="hide"
                       decoration-success="profit_margin &gt; 20"/>

                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft','collection')"
                       decoration-success="state == 'approved'"
                       decoration-warning="state in ('collected','sorting','quality')"
                       decoration-primary="state == 'sorted'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_harvest_batch_form" model="ir.ui.view">
        <field name="name">harvest.batch.form</field>
        <field name="model">harvest.batch</field>
        <field name="arch" type="xml">
            <form string="Harvest Batch">
                <header>
                    <!-- Draft State -->
                    <button name="action_start_collection"
                            string="Start Collection"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Collect lots from harvest schedule?"/>

                    <!-- Collection State -->
                    <button name="action_complete_collection"
                            string="Complete Collection"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'collection'"
                            confirm="This will create stock movements to sorting area. Continue?"/>

                    <!-- Collected State -->
                    <button name="action_start_sorting"
                            string="Start Sorting"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'collected'"/>

                    <!-- Sorting State -->
                    <button name="action_complete_sorting"
                            string="Complete Sorting"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'sorting'"
                            confirm="Finalize all sorting lines?"/>

                    <!-- Quality State -->
                    <button name="action_approve"
                            string="Approve Batch"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'quality'"
                            confirm="Approve this batch and create warehouse transfers?"/>

                    <button name="action_reject"
                            string="Reject Batch"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ('quality','sorted')"
                            confirm="Reject this batch?"/>

                    <!-- Other Actions -->
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('approved','rejected','cancelled')"
                            confirm="Cancel this batch?"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('rejected','cancelled')"
                            groups="base.group_system"
                            confirm="Reset to draft?"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,collection,collected,sorting,sorted,quality,approved"/>
                </header>

                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected'">
                        <strong>Batch Rejected</strong><br/>
                        <strong>Reason:</strong>
                        <field name="rejection_reason" readonly="1"
                               class="oe_inline"
                               invisible="not rejection_reason"/>
                    </div>

                    <!-- Button Box -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Lots -->
                        <button name="action_view_lots"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                invisible="lot_count == 0">
                            <field name="lot_count" widget="statinfo" string="Lots"/>
                        </button>

                        <!-- Sorting Lines -->
                        <button name="action_view_sorting_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sort-amount-desc"
                                invisible="sorting_line_count == 0">
                            <field name="sorting_line_count" widget="statinfo" string="Sorting Lines"/>
                        </button>

                        <!-- Pickings -->
                        <button name="action_view_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Stock Moves"/>
                        </button>

                        <!-- Journal Entries -->
                        <button name="action_view_accounting_entries"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="account_move_count == 0"
                                groups="account.group_account_readonly">
                            <field name="account_move_count" widget="statinfo" string="Journal Entries"/>
                        </button>

                        <!-- Schedule -->
                        <button name="action_view_schedule"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Schedule</span>
                            </div>
                        </button>

                        <!-- Project -->
                        <button name="action_view_project"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-folder-open"
                                invisible="not project_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Project</span>
                            </div>
                        </button>

                        <!-- Farm -->
                        <button name="action_view_farm"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-leaf"
                                invisible="not farm_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Farm</span>
                            </div>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                        <h3>
                            <field name="schedule_id" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>

                    <group>
                        <group name="main_info" string="Main Information">
                            <field name="schedule_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="project_id" readonly="1"/>
                            <field name="farm_id" readonly="1"/>
                            <field name="crop_id" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="batch_date"
                                   readonly="state not in ['draft','collection']"/>
                            <field name="responsible_id"
                                   widget="many2one_avatar_user"
                                   readonly="state not in ['draft','collection']"/>
                        </group>

                        <group name="quantities" string="Quantities">
                            <field name="estimated_quantity" readonly="1"
                                   widget="float"/>
                            <field name="actual_quantity" readonly="1"
                                   widget="float"
                                   decoration-bf="1"/>
                            <field name="total_weight" readonly="1"
                                   widget="float"/>
                            <field name="sorted_weight" readonly="1"
                                   widget="float"
                                   decoration-success="sorted_weight &gt; 0"/>
                            <field name="waste_weight" readonly="1"
                                   widget="float"
                                   decoration-danger="waste_percentage &gt; 20"/>
                            <field name="waste_percentage" readonly="1"
                                   widget="percentage"
                                   decoration-danger="waste_percentage &gt; 20"
                                   decoration-warning="waste_percentage &gt; 10"/>
                        </group>
                    </group>

                    <!-- Financial Summary -->
                    <group string="Financial Summary"
                           invisible="state not in ['sorted','quality','approved']"
                           groups="account.group_account_readonly">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="batch_cost" widget="monetary"/>
                            <field name="batch_revenue" widget="monetary"/>
                        </group>
                        <group>
                            <field name="batch_profit" widget="monetary"
                                   decoration-success="batch_profit &gt; 0"
                                   decoration-danger="batch_profit &lt; 0"/>
                            <field name="profit_margin" widget="percentage"
                                   decoration-success="profit_margin &gt; 20"
                                   decoration-warning="profit_margin &lt; 20 and profit_margin &gt; 10"/>
                        </group>
                    </group>

                    <!-- Team -->
                    <group string="Team" invisible="state == 'draft'">
                        <field name="worker_ids" widget="many2many_tags"
                               readonly="state not in ['draft','collection','collected','sorting']"/>
                    </group>

                    <notebook>
                        <!-- Collected Lots -->
                        <page string="Collected Lots" name="collected_lots">
                            <field name="collected_lot_ids"
                                   readonly="state not in ['draft','collection']"
                                   context="{'list_view_ref': 'agricultural_management.view_stock_production_lot_list_agricultural'}">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="quality_grade" widget="badge"/>
                                    <field name="harvest_date"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="quarantine" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <group>
                                <field name="lot_count" readonly="1"/>
                                <field name="actual_quantity" readonly="1"/>
                            </group>
                        </page>

                        <!-- Sorting Lines -->
                        <page string="Sorting Lines" name="sorting_lines">
                            <field name="sorting_line_ids" readonly="1"
                                   context="{'default_harvest_batch_id': id, 'default_project_id': project_id}">
                                <list decoration-success="state == 'approved'"
                                      decoration-info="state == 'sorted'"
                                      decoration-warning="state == 'quality'"
                                      decoration-danger="state == 'rejected'">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_variant_id"/>
                                    <field name="grade" widget="badge"
                                           decoration-success="grade == 'a'"
                                           decoration-info="grade == 'b'"
                                           decoration-warning="grade == 'c'"
                                           decoration-danger="grade == 'rejected'"/>
                                    <field name="size_category" widget="badge"/>
                                    <field name="initial_weight" string="Initial (kg)" widget="float"/>
                                    <field name="final_weight_kg" string="Final (kg)" widget="float"/>
                                    <field name="waste_weight" string="Waste (kg)" widget="float" optional="hide"/>
                                    <field name="waste_percentage" widget="percentage" optional="show"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="revenue" widget="monetary" optional="hide"/>
                                    <field name="cost" widget="monetary" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="sorting_line_count" readonly="1"/>
                                    <field name="sorted_weight" readonly="1"/>
                                </group>
                                <group>
                                    <field name="waste_weight" readonly="1"/>
                                    <field name="waste_percentage" readonly="1" widget="percentage"/>
                                </group>
                            </group>
                        </page>

                        <!-- Stock Movements -->
                        <page string="Stock Movements" name="stock_movements"
                              invisible="picking_count == 0">
                            <group string="Collection Pickings">
                                <field name="collection_picking_ids" nolabel="1" readonly="1">
                                    <list decoration-bf="state == 'done'">
                                        <field name="name"/>
                                        <field name="harvest_stage"/>
                                        <field name="scheduled_date"/>
                                        <field name="date_done"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Sorting Pickings">
                                <field name="sorting_picking_ids" nolabel="1" readonly="1">
                                    <list decoration-bf="state == 'done'">
                                        <field name="name"/>
                                        <field name="harvest_stage"/>
                                        <field name="scheduled_date"/>
                                        <field name="date_done"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </group>

                            <group>
                                <group>
                                    <field name="total_collection_qty" readonly="1"/>
                                    <field name="total_sorting_qty" readonly="1"/>
                                </group>
                                <group>
                                    <field name="total_completed_qty" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Accounting -->
                        <page string="Accounting" name="accounting"
                              invisible="account_move_count == 0"
                              groups="account.group_account_readonly">
                            <field name="account_move_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="ref"/>
                                    <field name="amount_total" sum="total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Add notes about this harvest batch..."
                                   readonly="state == 'approved'"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Kanban View -->
    <record id="view_harvest_batch_kanban" model="ir.ui.view">
        <field name="name">harvest.batch.kanban</field>
        <field name="model">harvest.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="batch_date"/>
                <field name="schedule_id"/>
                <field name="project_id"/>
                <field name="farm_id"/>
                <field name="crop_id"/>
                <field name="total_weight"/>
                <field name="sorted_weight"/>
                <field name="waste_percentage"/>
                <field name="batch_revenue"/>
                <field name="batch_profit"/>
                <field name="profit_margin"/>
                <field name="responsible_id"/>
                <field name="state"/>
                <field name="currency_id"/>
                <field name="lot_count"/>
                <field name="sorting_line_count"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="schedule_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>

                            <div class="o_kanban_record_body">
                                <!-- Date and Location -->
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fa fa-calendar" title="calendar"/> <field name="batch_date"/>
                                    </div>
                                    <div class="col-6">
                                        <i class="fa fa-leaf text-success" title="leaf"/> <field name="farm_id"/>
                                    </div>
                                </div>

                                <!-- Crop -->
                                <div class="row mt-1">
                                    <div class="col-12">
                                        <i class="fa fa-shopping-bag" title="shopping"/> <field name="crop_id"/>
                                    </div>
                                </div>

                                <!-- Weights -->
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <strong>Weights:</strong><br/>
                                        <i class="fa fa-balance-scale" title="balance scale"/> Total: <field name="total_weight"/> kg<br/>
                                        <i class="fa fa-check-circle text-success" title="check circle"/> Sorted: <field name="sorted_weight"/> kg
                                        <span t-if="record.waste_percentage.raw_value &gt; 0">
                                            <br/><i class="fa fa-trash text-danger" title="trash"/> Waste: <field name="waste_percentage"/>%
                                        </span>
                                    </div>
                                </div>

                                <!-- Lots Info -->
                                <div class="row mt-2" t-if="record.lot_count.raw_value &gt; 0">
                                    <div class="col-12">
                                        <span class="badge badge-info">
                                            <i class="fa fa-cubes" title="cubes"/> <field name="lot_count"/> Lots
                                        </span>
                                        <span class="badge badge-primary ml-1" t-if="record.sorting_line_count.raw_value &gt; 0">
                                            <i class="fa fa-sort" title="sort"/> <field name="sorting_line_count"/> Lines
                                        </span>
                                    </div>
                                </div>

                                <!-- Financial -->
                                <div class="row mt-2" t-if="record.state.raw_value in ['sorted','quality','approved']">
                                    <div class="col-12">
                                        <strong>Financial:</strong><br/>
                                        <field name="batch_revenue" widget="monetary"/><br/>
                                        <t t-if="record.batch_profit.raw_value &gt; 0">
                                            <span class="text-success">
                                                <i class="fa fa-arrow-up" title="arrow up"/> Profit: <field name="batch_profit" widget="monetary"/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="text-danger">
                                                <i class="fa fa-arrow-down" title="arrow down"/> Loss: <field name="batch_profit" widget="monetary"/>
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {
                                               'draft': 'secondary',
                                               'collection': 'info',
                                               'collected': 'primary',
                                               'sorting': 'warning',
                                               'sorted': 'primary',
                                               'quality': 'warning',
                                               'approved': 'success',
                                               'rejected': 'danger',
                                               'cancelled': 'secondary'
                                           }}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Pivot View -->
    <record id="view_harvest_batch_pivot" model="ir.ui.view">
        <field name="name">harvest.batch.pivot</field>
        <field name="model">harvest.batch</field>
        <field name="arch" type="xml">
            <pivot string="Batch Analysis" sample="1">
                <field name="project_id" type="row"/>
                <field name="farm_id" type="row"/>
                <field name="batch_date" interval="month" type="col"/>
                <field name="actual_quantity" type="measure"/>
                <field name="total_weight" type="measure"/>
                <field name="sorted_weight" type="measure"/>
                <field name="waste_weight" type="measure"/>
                <field name="batch_revenue" type="measure"/>
                <field name="batch_cost" type="measure"/>
                <field name="batch_profit" type="measure"/>
            </pivot>
        </field>
    </record>
    <!-- Graph View -->
    <record id="view_harvest_batch_graph" model="ir.ui.view">
        <field name="name">harvest.batch.graph</field>
        <field name="model">harvest.batch</field>
        <field name="arch" type="xml">
            <graph string="Batch Statistics" sample="1" type="bar">
                <field name="batch_date" interval="month"/>
                <field name="total_weight" type="measure"/>
                <field name="sorted_weight" type="measure"/>
                <field name="waste_weight" type="measure"/>
            </graph>
        </field>
    </record>
    <!-- Activity View -->
    <record id="view_harvest_batch_activity" model="ir.ui.view">
        <field name="name">harvest.batch.activity</field>
        <field name="model">harvest.batch</field>
        <field name="arch" type="xml">
            <activity string="Harvest Batches">
                <field name="name"/>
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="name" display="full"/>
                        </div>
                        <div>
                            <field name="farm_id" muted="1" display="full"/>
                        </div>
                        <div>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>
    <!-- Main Action -->
    <record id="action_harvest_batch" model="ir.actions.act_window">
        <field name="name">Harvest Batches</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">kanban,list,form,pivot,graph,activity</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Harvest Batch
            </p>
            <p>
                Collect harvest from lots and sort by quality.<br/>
                Track weights, waste, and profitability.
            </p>
        </field>
    </record>
    <!-- Dashboard Actions -->
    <record id="action_harvest_batch_draft" model="ir.actions.act_window">
        <field name="name">Draft Batches</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state','=','draft')]</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>
    <record id="action_harvest_batch_collection" model="ir.actions.act_window">
        <field name="name">Collection in Progress</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state','=','collection')]</field>
        <field name="context">{'search_default_collection': 1}</field>
    </record>
    <record id="action_harvest_batch_to_sort" model="ir.actions.act_window">
        <field name="name">Ready to Sort</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state','=','collected')]</field>
        <field name="context">{'search_default_collected': 1}</field>
    </record>
    <record id="action_harvest_batch_sorting" model="ir.actions.act_window">
        <field name="name">Sorting in Progress</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state','=','sorting')]</field>
        <field name="context">{'search_default_sorting': 1}</field>
    </record>
    <record id="action_harvest_batch_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Check</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state','=','quality')]</field>
        <field name="context">{'search_default_quality': 1}</field>
    </record>
    <record id="action_harvest_batch_approved" model="ir.actions.act_window">
        <field name="name">Approved Batches</field>
        <field name="res_model">harvest.batch</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="domain">[('state','=','approved')]</field>
        <field name="context">{'search_default_approved': 1}</field>
    </record>
