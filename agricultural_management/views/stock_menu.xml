      <field name="res_model">stock.location</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
      <field name="domain">[('usage', 'in', ['internal', 'view'])]</field>
    </record>
    <menuitem id="menu_agri_stock_locations"
              name="Locations"
              action="action_agri_stock_locations"
              parent="menu_agri_stock_locations_section"
              sequence="20"
              groups="stock.group_stock_user"/>

    <!-- Routes -->
    <record id="action_agri_stock_routes" model="ir.actions.act_window">
