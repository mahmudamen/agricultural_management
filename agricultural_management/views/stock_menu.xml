              action="action_agri_stock_routes"
              parent="menu_agri_stock_locations_section"
              sequence="30"
              groups="stock.group_adv_location"/>

    <!-- Operation Types -->
    <record id="action_agri_stock_picking_types" model="ir.actions.act_window">
 <field name="name"> Operations</field>
      <field name="res_model">stock.picking.type</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_stock_picking_types"
 name="Operations"
              action="action_agri_stock_picking_types"
              parent="menu_agri_stock_locations_section"
              sequence="40"
              groups="stock.group_stock_manager"/>

    <!-- Inventory Adjustments Section -->
    <menuitem id="menu_agri_stock_adjustments_section"
              name="Adjustments Inventory"
              parent="menu_agri_stock_root"
              sequence="40"
              groups="stock.group_stock_user"/>

    <!-- Inventory Adjustments -->
    <record id="action_agri_stock_inventory" model="ir.actions.act_window">
      <field name="name">Adjustments Inventory</field>
      <field name="res_model">stock.quant</field>
      <field name="view_mode">list</field>
      <field name="context">{'search_default_internal_loc': 1}</field>
      <field name="domain">[('location_id.usage', '=', 'internal')]</field>
    </record>
    <menuitem id="menu_agri_stock_inventory"
              name="Adjustments Inventory"
              action="action_agri_stock_inventory"
              parent="menu_agri_stock_adjustments_section"
              sequence="10"
              groups="stock.group_stock_manager"/>

    <!-- Scrap -->
    <record id="action_agri_stock_scrap" model="ir.actions.act_window">
 <field name="name"> Product"</field>
      <field name="res_model">stock.scrap</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_stock_scrap"
 name="Product"
              action="action_agri_stock_scrap"
              parent="menu_agri_stock_adjustments_section"
              sequence="20"
              groups="stock.group_stock_user"/>

    <!-- Reports Section -->
    <menuitem id="menu_agri_stock_reports_section"
              name="Reports"
              parent="menu_agri_stock_root"
              sequence="50"
              groups="stock.group_stock_user"/>

    <!-- Inventory Report -->
    <record id="action_agri_stock_inventory_report" model="ir.actions.act_window">
      <field name="name">Report Inventory</field>
      <field name="res_model">stock.quant</field>
      <field name="view_mode">list</field>
      <field name="context">{'search_default_internal_loc': 1, 'search_default_productgroup': 1}</field>
      <field name="domain">[('location_id.usage', '=', 'internal')]</field>
    </record>
    <menuitem id="menu_agri_stock_inventory_report"
              name="Report Inventory"
              action="action_agri_stock_inventory_report"
              parent="menu_agri_stock_reports_section"
              sequence="10"
              groups="stock.group_stock_user"/>

    <!-- Stock Moves History -->
    <record id="action_agri_stock_moves_report" model="ir.actions.act_window">
      <field name="name">Date Movements Inventory</field>
      <field name="res_model">stock.move</field>
      <field name="view_mode">list,pivot,graph</field>
      <field name="context">{'search_default_done': 1}</field>
      <field name="domain">[('state', '=', 'done')]</field>
    </record>
    <menuitem id="menu_agri_stock_moves_report"
              name="Date Movements Inventory"
              action="action_agri_stock_moves_report"
              parent="menu_agri_stock_reports_section"
              sequence="20"
              groups="stock.group_stock_user"/>

    <!-- Product Moves -->
    <record id="action_agri_stock_product_moves" model="ir.actions.act_window">
 <field name="name">Movements Product</field>
      <field name="res_model">stock.move.line</field>
      <field name="view_mode">list,pivot</field>
      <field name="context">{'search_default_done': 1}</field>
      <field name="domain">[('state', '=', 'done')]</field>
    </record>
    <menuitem id="menu_agri_stock_product_moves"
 name="Movements Product"
              action="action_agri_stock_product_moves"
              parent="menu_agri_stock_reports_section"
              sequence="40"
              groups="stock.group_stock_user"/>

    <!-- Forecasted Inventory -->
    <record id="action_agri_stock_forecasted" model="ir.actions.act_window">
 <field name="name">Inventory </field>
      <field name="res_model">stock.quant</field>
      <field name="view_mode">list</field>
      <field name="context">{'search_default_internal_loc': 1}</field>
      <field name="domain">[('location_id.usage', '=', 'internal')]</field>
