              parent="menu_agri_stock_root"
              sequence="60"
              groups="stock.group_stock_manager"/>







    <!-- Advanced Operations Section -->
    <menuitem id="menu_agri_stock_advanced_section"
 name="Operations"
              parent="menu_agri_stock_root"
              sequence="70"
              groups="stock.group_adv_location"/>



  </data>
</odoo>