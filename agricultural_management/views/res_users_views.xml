<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form_agricultural" model="ir.ui.view">
            <field name="name">res.users.form.agricultural</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="priority">30</field>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="before">

                    <separator string="AGRICULTURAL MANAGEMENT"/>
                    <group>
                        <group>
                            <field name="agricultural_role" widget="radio"/>
                        </group>
                    </group>

                    <separator string="AGRICULTURAL DEPARTMENTS"/>
                    <group>
                        <group>
                            <field name="is_agri_warehouse_manager"/>
                            <field name="is_agri_purchase_manager"/>
                            <field name="is_agri_accountant"/>
                            <field name="is_agri_post_entry"/>
                        </group>
                        <group>
                            <field name="is_agri_section_user"/>
                            <field name="is_agri_section_manager"/>
                            <field name="is_agri_reset_entry"/>
                        </group>
                    </group>

                </xpath>

            </field>
        </record>
    </data>
</odoo>
