<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Purchase Root Menu -->
    <menuitem id="menu_agri_purchase_root"
              name="Purchases"
              parent="menu_agricultural_sections_purchase"
              sequence="30"
              groups="group_purchase_manager,purchase.group_purchase_user"/>

    <!-- Purchase Orders Section -->
    <menuitem id="menu_agri_purchase_orders_section"
              name="Purchase Orders"
              parent="menu_agri_purchase_root"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <!-- All Purchase Orders -->
    <record id="action_agri_purchase_all_orders" model="ir.actions.act_window">
 <field name="name"> Purchase Orders</field>
      <field name="res_model">purchase.order</field>
      <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Create Purchase Order New</p>
      </field>
    </record>
    <menuitem id="menu_agri_purchase_all_orders"
 name="Purchase Orders"
              action="action_agri_purchase_all_orders"
              parent="menu_agri_purchase_orders_section"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <!-- Request for Quotations -->
    <record id="action_agri_purchase_rfq" model="ir.actions.act_window">
      <field name="name">Requests Quotations</field>
      <field name="res_model">purchase.order</field>
      <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
      <field name="domain">[('state','in',['draft','sent','to approve'])]</field>
      <field name="context">{'default_state':'draft'}</field>
    </record>
    <menuitem id="menu_agri_purchase_rfq"
              name="Requests Quotations"
              action="action_agri_purchase_rfq"
              parent="menu_agri_purchase_orders_section"
              sequence="20"
              groups="purchase.group_purchase_user"/>

    <!-- Purchase Orders to Approve -->
    <record id="action_agri_purchase_to_approve" model="ir.actions.act_window">
 <field name="name">Purchase Orders Approve</field>
      <field name="res_model">purchase.order</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('state','=','to approve')]</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_purchase_to_approve"
 name="Approve"
              action="action_agri_purchase_to_approve"
              parent="menu_agri_purchase_orders_section"
              sequence="30"
              groups="purchase.group_purchase_manager"/>

    <!-- Purchase Agreements Section -->
    <menuitem id="menu_agri_purchase_agreements_section"
              name="Purchase Agreements"
              parent="menu_agri_purchase_root"
              sequence="20"
              groups="group_purchase_manager"/>


    <!-- Vendors Section -->
    <menuitem id="menu_agri_vendors_section"
 name=""
              parent="menu_agri_purchase_root"
              sequence="30"
              groups="purchase.group_purchase_user"/>

    <!-- All Vendors -->
    <record id="action_agri_all_vendors" model="ir.actions.act_window">
      <field name="name">All Vendors</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('is_company','=',True),('supplier_rank','>',0)]</field>
      <field name="context">{'default_is_company': True, 'default_supplier_rank': 1}</field>
    </record>
    <menuitem id="menu_agri_all_vendors"
              name="All Vendors"
              action="action_agri_all_vendors"
              parent="menu_agri_vendors_section"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <!-- Vendor Pricelists -->
    <record id="action_agri_vendor_pricelists" model="ir.actions.act_window">
      <field name="name">Vendor Price Lists</field>
      <field name="res_model">product.supplierinfo</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_vendor_pricelists"
              name="Vendor Price Lists"
              action="action_agri_vendor_pricelists"
              parent="menu_agri_vendors_section"
              sequence="20"
              groups="purchase.group_purchase_user"/>

    <!-- Products Section -->
    <menuitem id="menu_agri_purchase_products_section"
 name="Product"
              parent="menu_agri_purchase_root"
              sequence="40"
              groups="purchase.group_purchase_user"/>

    <!-- Products to Buy -->
    <record id="action_agri_products_to_buy" model="ir.actions.act_window">
 <field name="name"> </field>
      <field name="res_model">product.template</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('purchase_ok','=',True)]</field>
      <field name="context">{'default_purchase_ok': True}</field>
    </record>
    <menuitem id="menu_agri_products_to_buy"
 name="Products"
              action="action_agri_products_to_buy"
              parent="menu_agri_purchase_products_section"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <!-- Reports Section -->
    <menuitem id="menu_agri_purchase_reports_section"
              name="Reports"
              parent="menu_agri_purchase_root"
              sequence="50"
              groups="purchase.group_purchase_user"/>

    <!-- Purchase Analysis -->
    <record id="action_agri_purchase_analysis" model="ir.actions.act_window">
      <field name="name">Analysis Purchases</field>
      <field name="res_model">purchase.report</field>
      <field name="view_mode">pivot,graph,list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_purchase_analysis"
              name="Analysis Purchases"
              action="action_agri_purchase_analysis"
              parent="menu_agri_purchase_reports_section"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <!-- Purchase Order Lines -->
    <record id="action_agri_purchase_order_lines" model="ir.actions.act_window">
 <field name="name"> Purchase Orders</field>
      <field name="res_model">purchase.order.line</field>
      <field name="view_mode">list,form,pivot,graph</field>
      <field name="context">{'search_default_group_by_order':1}</field>
    </record>
    <menuitem id="menu_agri_purchase_order_lines"
 name="Purchase Orders"
              action="action_agri_purchase_order_lines"
              parent="menu_agri_purchase_reports_section"
              sequence="20"
              groups="purchase.group_purchase_user"/>

    <!-- Vendor Performance -->
    <record id="action_agri_vendor_performance" model="ir.actions.act_window">
      <field name="name">Vendor Performance</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('supplier_rank','>',0)]</field>
      <field name="context">{'search_default_group_by_country':1}</field>
    </record>
    <menuitem id="menu_agri_vendor_performance"
              name="⭐ Vendor Performance"
              action="action_agri_vendor_performance"
              parent="menu_agri_purchase_reports_section"
              sequence="30"
              groups="purchase.group_purchase_user"/>

    <!-- Configuration Section -->
    <menuitem id="menu_agri_purchase_config_section"
              name="Settings"
              parent="menu_agri_purchase_root"
              sequence="60"
              groups="purchase.group_purchase_manager"/>

    <!-- Product Categories -->
    <record id="action_agri_purchase_categories" model="ir.actions.act_window">
 <field name="name">Categories Product</field>
      <field name="res_model">product.category</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_purchase_categories"
 name="Categories Product"
              action="action_agri_purchase_categories"
              parent="menu_agri_purchase_config_section"
              sequence="10"
              groups="purchase.group_purchase_manager"/>



    <!-- Unit of Measures -->
    <record id="action_agri_purchase_uom" model="ir.actions.act_window">
 <field name="name"> </field>
      <field name="res_model">uom.uom</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_purchase_uom"
 name=""
              action="action_agri_purchase_uom"
              parent="menu_agri_purchase_config_section"
              sequence="30"
              groups="purchase.group_purchase_manager"/>

    <!-- Terms and Conditions -->
    <record id="action_agri_purchase_terms" model="ir.actions.act_window">
      <field name="name">Terms &amp; Conditions</field>
      <field name="res_model">account.payment.term</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_agri_purchase_terms"
              name="Terms &amp; Conditions"
              action="action_agri_purchase_terms"
              parent="menu_agri_purchase_config_section"
              sequence="40"
              groups="purchase.group_purchase_manager"/>

  </data>
</odoo>
