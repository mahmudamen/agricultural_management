                                                    <button class="btn btn-primary btn-sm" name="action_vehicle_maintenance" type="object">
 <i class="fa fa-tools"/> Vehicles
                                                    </button>
                                                </div>
                                                <div class="col-3">
                                                    <button class="btn btn-success btn-sm" name="action_service_requests" type="object">
 <i class="fa fa-wrench"/> Requests 
                                                    </button>
                                                </div>
                                                <div class="col-3">
                                                    <button class="btn btn-warning btn-sm" name="action_parts_inventory" type="object">
                                                        <i class="fa fa-cog"/> Spare Parts Stock
