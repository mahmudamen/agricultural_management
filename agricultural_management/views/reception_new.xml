                                                </div>
                                                <div class="col-3">
                                                    <button class="btn btn-info btn-sm" name="action_maintenance_schedule" type="object">
 <i class="fa fa-calendar-check"/> Maintenance
                                                    </button>
                                                </div>
                                            </div>
