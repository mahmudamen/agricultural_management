        <!-- Pivot View -->
        <record id="view_agricultural_farm_pivot" model="ir.ui.view">
            <field name="name">agricultural.farm.pivot</field>
            <field name="model">agricultural.farm</field>
            <field name="arch" type="xml">
                <pivot string="Farm Analysis" sample="1" display_quantity="1">
                    <field name="level" type="row"/>
                    <field name="farm_type" type="row"/>
                    <field name="total_area" type="measure"/>
                    <field name="total_cost" type="measure"/>
                    <field name="total_sales" type="measure"/>
                    <field name="employee_count" type="measure"/>
                    <field name="house_count" type="measure"/>
                </pivot>
            </field>
        </record>
        <!-- Farm Management Actions -->
        <record id="action_agricultural_farm" model="ir.actions.act_window">
            <field name="name">Houses Agricultural</field>
            <field name="res_model">agricultural.farm</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="view_ids" eval="[(5, 0, 0),
                                (0, 0, {'view_mode': 'list', 'view_id': ref('view_agricultural_farm_list_enhanced'), 'sequence': 1}),
                                (0, 0, {'view_mode': 'form', 'view_id': ref('view_agricultural_farm_form'), 'sequence': 3}),
                                (0, 0, {'view_mode': 'graph', 'view_id': ref('view_agricultural_farm_graph'), 'sequence': 4}),
                                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_agricultural_farm_pivot'), 'sequence': 5})]"/>

        </record>
