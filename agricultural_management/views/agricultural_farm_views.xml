                    <field name="total_area" type="measure"/>
                    <field name="total_cost" type="measure"/>
                    <field name="total_sales" type="measure"/>
                    <field name="employee_count" type="measure"/>
                </graph>
            </field>
        </record>
        <record id="view_agricultural_farm_graph_pie" model="ir.ui.view">
            <field name="name">agricultural.farm.graph.pie</field>
            <field name="model">agricultural.farm</field>
            <field name="arch" type="xml">
                <graph string="Farm Distribution" type="pie" sample="1">
                    <field name="level" type="row"/>
                    <field name="total_area" type="measure"/>
                </graph>
            </field>
        </record>
        <record id="view_agricultural_farm_graph_line" model="ir.ui.view">
