<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="engineer_list_farm" model="ir.ui.view">
            <field name="name">engineer_list_farm</field>
            <field name="model">agricultural.farm</field>
            <field name="arch" type="xml">
                <list string="Agricultural Houses List">
                    <field name="display_name"/>
                    <field name="farm_type"/>
                    <field name="level"/>
                    <button name="agricultural_production_request_action"
                            type="object"
                            string="Add Raw Materials or Consumables"
                            class="oe_highlight"/>
                </list>
            </field>
        </record>
        <record id="production_request_line_list_farm" model="ir.ui.view">
            <field name="name">production_request_line_list_farm</field>
            <field name="model">agricultural.production.request.line</field>
            <field name="arch" type="xml">
                <list string="Agricultural Sector Requests">
                    <field name="request_id" />
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="uom_id"/>
                    <button name="agricultural_production_request_line_action"
                            type="object"
                            string="Details"
                            class="oe_highlight"/>
                </list>
            </field>
        </record>
        <record id="res_partner_list_farm" model="ir.ui.view">
            <field name="name">res_partner_list_farm</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list default_order="name" string="Subsidiaries" decoration-primary="company_type=='company'"
                        decoration-muted="company_type!='company'"  editable="bottom" limit="20">
                    <field name="name" />
                    <field name="company_type" column_invisible="1"/>
                    <field name="property_stock_dest"/>
                    <button name="create_invoice"
                            type="object"
                            string="Create Invoice"
                            class="btn-primary"/>
                    <button name="create_stock_picking"
                            type="object"
                            string="Issue Materials to Company"
                            class="oe_highlight"/>
                    <button name="create_stock_picking"
                            type="object"
                            string="Issue Materials"
                            class="oe_highlight"
                            icon="fa-truck"/>
                    <button name="create_customer_invoice"
                            type="object"
                            string="Customer Invoice"
                            class="btn-primary"
                            icon="fa-file-text-o"/>
                    <button name="create_vendor_bill"
                            type="object"
                            string="Vendor Bill"
                            class="btn-info"
                            icon="fa-file-text"/>
                    <button name="create_credit_note"
                            type="object"
                            string="Credit Note"
                            class="btn-warning"
                            icon="fa-undo"/>
                </list>
            </field>
        </record>
        <record id="res_partner_list_farm_inherit" model="ir.ui.view">
            <field name="name">res.partner.view.inventory</field>
            <field name="model">res.partner</field>
            <field name="priority" eval="1"/>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <group>
                        <field name="property_account_receivable_id" />
                        <field name="property_account_payable_id" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>