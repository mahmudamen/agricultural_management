<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="agricultural_product_template_form_view" model="ir.ui.view">
            <field name="name">agricultural_product_template_form_view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="after">
                    <div name="agriculturall_options" class="mb24">
                        <field name="agricultural_product_type" widget="radio" options="{'horizontal': true}"/>
                    </div>
                </xpath>
                <xpath expr="//page[@name='general_information']" position="before">
                    <page name="agricultural_settings" string="Settings">
                        <group>
                            <group>
                                <field name="request_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="available_in"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>