<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Agricultural Cost Allocation list View -->
    <record id="view_agricultural_cost_allocation_list" model="ir.ui.view">
        <field name="name">agri.cost.allocation.list</field>
        <field name="model">agri.cost.allocation</field>
        <field name="arch" type="xml">
            <list string="Cost Allocations" decoration-info="state=='draft'"
                  decoration-success="state=='confirmed'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="farm_id"/>
                <field name="cost_category"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Agricultural Cost Allocation Form View -->
    <record id="view_agricultural_cost_allocation_form" model="ir.ui.view">
        <field name="name">agri.cost.allocation.form</field>
        <field name="model">agri.cost.allocation</field>
        <field name="arch" type="xml">
            <form string="Agricultural Cost Allocation">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'draft'"/>

                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in  ['cancelled', 'validated']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="farm_id" required="1"/>
                            <field name="cost_category"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Allocation Lines">
                            <field name="allocation_line_ids">
                                <list editable="bottom">
                                    <field name="project_id"/>
                                    <field name="farm_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="allocation_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Agricultural Cost Calculation list View -->
    <record id="view_agricultural_cost_calculation_list" model="ir.ui.view">
        <field name="name">agri.cost.calculation.list</field>
        <field name="model">agri.cost.calculation</field>
        <field name="arch" type="xml">
            <list string="Cost Calculations" decoration-info="state=='draft'"
                  decoration-success="state=='calculated'">
                <field name="name"/>
                <field name="calculation_date"/>
                <field name="farm_id"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="total_area_m2"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Agricultural Cost Calculation Form View -->
    <record id="view_agricultural_cost_calculation_form" model="ir.ui.view">
        <field name="name">agri.cost.calculation.form</field>
        <field name="model">agri.cost.calculation</field>
        <field name="arch" type="xml">
            <form string="Agricultural Cost Calculation">
                <header>
                    <button name="action_calculate" type="object" string="Calculate Costs"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_recalculate" type="object" string="Recalculate"
                            invisible="state !=  'calculated'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="calculation_date"/>
                            <field name="farm_id" required="1"/>
                            <field name="area_hectares"/>
                        </group>
                        <group>
                            <field name="total_cost"/>
                            <field name="cost_per_hectare"/>
                            <field name="cost_per_unit"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Calculation Lines">
                            <field name="cost_line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="allocation_method"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary">
                            <group>
                                <group string="Direct Costs">
                                    <field name="seed_costs"/>
                                    <field name="fertilizer_costs"/>
                                    <field name="pesticide_costs"/>
                                    <field name="direct_labor_cost"/>
                                </group>
                                <group string="Indirect Costs">
                                    <field name="maintenance_cost"/>
                                    <field name="depreciation_cost"/>
                                    <field name="overhead_cost"/>
                                    <field name="utilities_cost"/>
                                    <field name="transportation_cost" />
                                    <field name="packaging_cost" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View for Cost Calculations -->
    <record id="view_agricultural_cost_calculation_kanban" model="ir.ui.view">
        <field name="name">agri.cost.calculation.kanban</field>
        <field name="model">agri.cost.calculation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="farm_id"/>
                <field name="total_cost"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>

                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-att-class="'badge badge-pill ' + (record.state.raw_value === 'calculated' ? 'badge-success' : 'badge-info')">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <strong>$<field name="total_cost"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
            <!-- Agricultural Production Calculation Line list View -->
    <record id="view_agricultural_production_calculation_line_list" model="ir.ui.view">
        <field name="name">agri.production.calculation.line.list</field>
        <field name="model">agri.production.calculation.line</field>
        <field name="arch" type="xml">
            <list string="Production Calculation Lines" editable="top">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="cost" sum="Total Cost"/>
                <field name="profit" sum="Total Profit"/>
            </list>
        </field>
    </record>

    <!-- Agricultural Production Calculation Line Form View -->
    <record id="view_agricultural_production_calculation_line_form" model="ir.ui.view">
        <field name="name">agri.production.calculation.line.form</field>
        <field name="model">agri.production.calculation.line</field>
        <field name="arch" type="xml">
            <form string="Production Calculation Line">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="revenue"/>
                            <field name="cost"/>
                            <field name="profit" />
                        </group>
                    </group>
                    <group string="Additional Information">
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

        <!-- Agricultural Inventory Stage list View -->
    <record id="view_agricultural_inventory_stage_list" model="ir.ui.view">
        <field name="name">agri.inventory.stage.list</field>
        <field name="model">agri.inventory.stage</field>
        <field name="arch" type="xml">
            <list string="Inventory Stages" decoration-info="stage_type=='input'"
                  decoration-success="stage_type=='output'" decoration-warning="stage_type=='process'">
                <field name="name"/>
                <field name="stage_type"/>
                <field name="farm_id"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="quantity_in"/>
                <field name="uom_id"/>
                <field name="location_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Agricultural Inventory Stage Form View -->
    <record id="view_agricultural_inventory_stage_form" model="ir.ui.view">
        <field name="name">agri.inventory.stage.form</field>
        <field name="model">agri.inventory.stage</field>
        <field name="arch" type="xml">
            <form string="Agricultural Inventory Stage">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'draft'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="stage_type"/>
                            <field name="farm_id"/>
                            <field name="date"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="quantity_in"/>
                            <field name="uom_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="description" placeholder="Stage description..."/>
                            </group>
                        </page>
                        <page string="Quality Control" invisible="stage_type !=  'output'">
                            <group>
                                <group>
                                    <field name="quality_grade"/>
                                    <field name="quality_score"/>
                                </group>
                                <group>
                                    <field name="defect_rate" placeholder="Defect Rate..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View for Inventory Stages -->
    <record id="view_agricultural_inventory_stage_kanban" model="ir.ui.view">
        <field name="name">agri.inventory.stage.kanban</field>
        <field name="model">agri.inventory.stage</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_type">
                <field name="name"/>
                <field name="stage_type"/>
                <field name="product_id"/>
                <field name="quantity_in"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle">
                                            <field name="product_id"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="quantity_in"/> <field name="uom_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-att-class="'badge badge-pill ' + (record.state.raw_value === 'validated' ? 'badge-success' : record.state.raw_value === 'confirmed' ? 'badge-warning' : 'badge-info')">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
            <!-- Actions -->
    <!-- Cost Allocation Action -->
    <record id="action_agricultural_cost_allocation" model="ir.actions.act_window">
        <field name="name">Cost Allocations</field>
        <field name="res_model">agri.cost.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_season': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cost allocation!
            </p>
            <p>
                Allocate and track agricultural costs across different farms, crops, and seasons.
            </p>
        </field>
    </record>

    <!-- Cost Calculation Action -->
    <record id="action_agricultural_cost_calculation" model="ir.actions.act_window">
        <field name="name">Cost Calculations</field>
        <field name="res_model">agri.cost.calculation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cost calculation!
            </p>
            <p>
                Calculate and analyze agricultural production costs for better decision making.
            </p>
        </field>
    </record>

    <!-- Production Calculation Lines Action -->
    <record id="action_agricultural_production_calculation_line" model="ir.actions.act_window">
        <field name="name">Production Calculations</field>
        <field name="res_model">agri.production.calculation.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start tracking production calculations!
            </p>
            <p>
                Monitor planned vs actual production quantities and analyze variances.
            </p>
        </field>
    </record>


    <!-- Cost Allocation Line Action (for line management) -->
        <!-- Cost Allocation Line Action (for line management) -->
    <record id="action_agricultural_cost_allocation_line" model="ir.actions.act_window">
        <field name="name">Cost Allocation Lines</field>
        <field name="res_model">agri.cost.allocation.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage allocation line items!
            </p>
            <p>
                View and manage individual cost allocation line items across all allocations.
            </p>
        </field>
    </record>

    <!-- Cost Calculation Line Action -->
    <record id="action_agricultural_cost_calculation_line" model="ir.actions.act_window">
        <field name="name">Cost Calculation Lines</field>
        <field name="res_model">agri.cost.calculation.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage calculation details!
            </p>
            <p>
                View and manage individual cost calculation line items.
            </p>
        </field>
    </record>

    <!-- Server Actions -->


    </data>
</odoo>