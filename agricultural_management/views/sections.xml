<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Form View -->
    <record id="view_res_sections_form" model="ir.ui.view">
        <field name="name">res.sections.form</field>
        <field name="model">res.sections</field>
        <field name="arch" type="xml">
            <form string="Agricultural Section">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,inactive"/>
 <button name="toggle_active" type="object" string="" class="btn-primary"/>
                </header>
                <sheet>
                    <!-- Title and Priority -->
                    <div class="oe_button_box" name="button_box">
                        <button name="agricultural_production_request_view" type="object"
                                class="oe_stat_button" icon="fa-industry">
 <field name="assigned_users_count" widget="statinfo" string="User"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="priority" widget="priority" class="mr-3"/>
 <field name="name" placeholder="..." class="oe_inline"/>
                        </h1>
                        <label for="code" class="oe_edit_only"/>
                        <h3>
 <field name="code" placeholder="..." class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="type" widget="selection"/>
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="sequence" widget="handle"/>
                        </group>

                    </group>
                    <group>
                        <group string="Access Settings">
                            <field name="is_public" widget="boolean_toggle"/>
                            <field name="is_critical" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="user_has_access" widget="boolean" readonly="1"/>
                        </group>
                    </group>

                    <!-- Notebook with Multiple Pages -->
                    <notebook>
                        <page string="User &amp; Permissions" name="users_permissions">
                            <group>
                                <group string="User Management">
                                    <field name="manager_id" widget="many2one_avatar_user"/>
                                    <field name="assigned_users_count" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description &amp; Notes" name="description">
                            <group>
                                <field name="description" widget="text" placeholder="Section description..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    <!-- list View -->
    <record id="view_res_sections_list" model="ir.ui.view">
        <field name="name">res.sections.list</field>
        <field name="model">res.sections</field>
        <field name="arch" type="xml">
            <list string="Agricultural Sections"
                  decoration-success="status=='active'"
                  decoration-muted="not active"
                  decoration-danger="is_critical"
                  decoration-warning="status=='draft'"
                  create="1" delete="1" edit="1">
                <field name="sequence" widget="handle"/>
 <field name="name" string=""/>
 <field name="code" string=""/>
 <field name="type" string=""/>
 <field name="manager_id" widget="many2one_avatar_user" string="Manager"/>
                <field name="priority" widget="priority" string="Priority"/>
                <field name="status" widget="badge"
                       decoration-success="status=='active'"
                       decoration-info="status=='draft'"
                       decoration-muted="status=='inactive'"
                       decoration-danger="status=='archived'" string="Status"/>
 <field name="assigned_users_count" string="User"/>
 <field name="rating" widget="priority" string=""/>
 <field name="is_public" widget="boolean_toggle" string=""/>
 <field name="is_critical" widget="boolean_toggle" string=""/>
                <field name="active" widget="boolean_toggle" string="Active"/>
                <field name="color" invisible="1"/>
            </list>
        </field>
    </record>
    <!-- Actions -->
    <record id="sections_action" model="ir.actions.act_window">
        <field name="name">Sections Agricultural</field>
        <field name="res_model">res.sections</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Agricultural Section New!
            </p>
            <p>
 Sections Agricultural helps you organize andManagement Operations Farm.
            </p>
        </field>
    </record>

    </data>
</odoo>