<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Accounting Root Menu -->
    <menuitem id="menu_agri_acct_task_root"
 name=""
              parent="menu_accountant_task"
              sequence="40"
              groups="group_accounts,account.group_account_user"/>
    <!-- Journal Entries Section -->
    <menuitem id="menu_acct_entries_section"
 name="Movements"
              parent="menu_agri_acct_task_root"
              sequence="10"
              groups="group_accounts,account.group_account_user"/>
    <!-- All Journal Entries -->
    <record id="action_agri_acc_all_entries" model="ir.actions.act_window">
      <field name="name">All Entries</field>
      <field name="res_model">account.move</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="context">{}</field>
      <field name="help" type="html">
 <p class="o_view_nocontent_smiling_face"> New</p>
      </field>
    </record>
    <menuitem id="menu_acct_task_all_entries"
              name="All Entries"
              action="action_agri_acc_all_entries"
              parent="menu_acct_entries_section"
              sequence="10"
              groups="group_accounts,account.group_account_user"/>
    <!-- Manual Journal Entries -->
    <record id="action_agri_acc_manual_entries" model="ir.actions.act_window">
      <field name="name">Manual Entries</field>
      <field name="res_model">account.move</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('move_type','=','entry')]</field>
      <field name="context">{'default_move_type':'entry'}</field>
    </record>
    <menuitem id="menu_acct_task_manual_entries"
              name="Manual Entries"
              action="action_agri_acc_manual_entries"
              parent="menu_acct_entries_section"
              sequence="20"
              groups="group_accounts,account.group_account_user"/>
    <!-- Bills &amp; Invoices Section -->
    <menuitem id="menu_acct_bills_section"
 name="Invoices Purchases"
              parent="menu_agri_acct_task_root"
              sequence="20"
              groups="group_accounts,account.group_account_user"/>
    <!-- Customer Invoices -->
    <record id="action_agri_acc_customer_invoices" model="ir.actions.act_window">
      <field name="name">Customer Invoices</field>
      <field name="res_model">account.move</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('move_type','in',['out_invoice','out_refund'])]</field>
      <field name="context">{'default_move_type':'out_invoice'}</field>
    </record>
    <menuitem id="menu_acct_task_customer_invoices"
              name="Customer Invoices"
              action="action_agri_acc_customer_invoices"
              parent="menu_acct_bills_section"
              sequence="10"
              groups="group_accounts,account.group_account_user"/>
    <!-- Vendor Bills -->
    <record id="action_agri_acc_vendor_bills" model="ir.actions.act_window">
      <field name="name">Vendor Bills</field>
      <field name="res_model">account.move</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('move_type','in',['in_invoice','in_refund'])]</field>
      <field name="context">{'default_move_type':'in_invoice'}</field>
    </record>
    <menuitem id="menu_acct_task_vendor_bills"
              name="Vendor Bills"
              action="action_agri_acc_vendor_bills"
              parent="menu_acct_bills_section"
              sequence="20"
              groups="group_accounts,account.group_account_user"/>
    <!-- Credit Notes -->
    <record id="action_agri_acc_credit_notes" model="ir.actions.act_window">
      <field name="name">Credit Notes</field>
      <field name="res_model">account.move</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('move_type','in',['out_refund','in_refund'])]</field>
      <field name="context">{'default_move_type':'out_refund'}</field>
    </record>
    <menuitem id="menu_acct_task_credit_notes"
              name="Credit Notes"
              action="action_agri_acc_credit_notes"
              parent="menu_acct_bills_section"
              sequence="30"
              groups="group_accounts,account.group_account_user"/>
    <!-- Payments Section -->
    <menuitem id="menu_acct_payments_section"
 name=""
              parent="menu_agri_acct_task_root"
              sequence="30"
              groups="group_accounts,account.group_account_user"/>
    <!-- All Payments -->
    <record id="action_agri_acc_all_payments" model="ir.actions.act_window">
      <field name="name">All Payments</field>
      <field name="res_model">account.payment</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_acct_task_all_payments"
              name="All Payments"
              action="action_agri_acc_all_payments"
              parent="menu_acct_payments_section"
              sequence="10"
              groups="group_accounts,account.group_account_user"/>
    <!-- Customer Payments -->
    <record id="action_agri_acc_customer_payments" model="ir.actions.act_window">
      <field name="name">Customer Payments</field>
      <field name="res_model">account.payment</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('partner_type','=','customer')]</field>
      <field name="context">{'default_partner_type':'customer','default_payment_type':'inbound'}</field>
    </record>
    <menuitem id="menu_acct_task_customer_payments"
              name="Customer Payments"
              action="action_agri_acc_customer_payments"
              parent="menu_acct_payments_section"
              sequence="20"
              groups="group_accounts,account.group_account_user"/>
    <!-- Vendor Payments -->
    <record id="action_agri_acc_vendor_payments" model="ir.actions.act_window">
      <field name="name">Vendor Payments</field>
      <field name="res_model">account.payment</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="domain">[('partner_type','=','supplier')]</field>
      <field name="context">{'default_partner_type':'supplier','default_payment_type':'outbound'}</field>
    </record>
    <menuitem id="menu_acct_task_vendor_payments"
              name="Vendor Payments"
              action="action_agri_acc_vendor_payments"
              parent="menu_acct_payments_section"
              sequence="30"
              groups="group_accounts,account.group_account_user"/>
    <!-- Chart of Accounts Section -->
    <menuitem id="menu_acct_task_accounts_section"
              name="Guide Accounts"
              parent="menu_agri_acct_task_root"
              sequence="40"
              groups="group_accounts,account.group_account_user"/>
    <!-- Chart of Accounts -->
    <record id="action_agri_acc_accounts" model="ir.actions.act_window">
      <field name="name">Tree Accounts</field>
      <field name="res_model">account.account</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_acct_task_accounts"
              name="Tree Accounts"
              action="action_agri_acc_accounts"
              parent="menu_acct_task_accounts_section"
              sequence="10"
              groups="group_accounts,account.group_account_user"/>
    <!-- Journals -->
    <record id="action_agri_acc_journals" model="ir.actions.act_window">
      <field name="name">Journals</field>
      <field name="res_model">account.journal</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_acct_task_journals"
              name="Journals"
              action="action_agri_acc_journals"
              parent="menu_acct_task_accounts_section"
              sequence="30"
              groups="group_accounts,account.group_account_user"/>
    <!-- Reports Section -->
    <menuitem id="menu_acct_reports_section"
              name="Reports"
              parent="menu_agri_acct_task_root"
              sequence="50"
              groups="group_accounts,account.group_account_user"/>
    <!-- Partner Ledger -->
    <record id="action_agri_acc_partner_ledger" model="ir.actions.act_window">
      <field name="name">Partner Ledger</field>
      <field name="res_model">account.move.line</field>
      <field name="view_mode">list</field>
      <field name="context">{'search_default_group_by_account':1}</field>
    </record>
    <menuitem id="menu_acct_task_partner_ledger"
              name="Partner Ledger"
              action="action_agri_acc_partner_ledger"
              parent="menu_acct_reports_section"
              sequence="10"
              groups="group_accounts,account.group_account_user"/>
    <!-- Analytic Accounting Section (only if analytic module is installed) -->
    <menuitem id="menu_acct_task_analytic_section"
              name="Accounts Analytic"
              parent="menu_agri_acct_task_root"
              sequence="60"
              groups="analytic.group_analytic_accounting"/>
    <!-- Analytic Accounts -->
    <record id="action_agri_acc_analytic_accounts" model="ir.actions.act_window">
      <field name="name">Accounts Analytic</field>
      <field name="res_model">account.analytic.account</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_acct_task_analytic_accounts"
              name="Accounts Analytic"
              action="action_agri_acc_analytic_accounts"
              parent="menu_acct_task_analytic_section"
              sequence="10"
              groups="analytic.group_analytic_accounting"/>
    <!-- Configuration Section -->
    <menuitem id="menu_acct_task_config_section"
              name="Settings"
              parent="menu_agri_acct_task_root"
              sequence="70"
              groups="account.group_account_manager"/>
    <!-- Payment Terms -->
    <record id="action_agri_acc_payment_terms" model="ir.actions.act_window">
      <field name="name">Payment Terms</field>
      <field name="res_model">account.payment.term</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_acct_task_payment_terms"
              name="Payment Terms"
              action="action_agri_acc_payment_terms"
              parent="menu_acct_task_config_section"
              sequence="10"
              groups="account.group_account_manager"/>
    <!-- Tax Configuration -->
    <record id="action_agri_acc_taxes" model="ir.actions.act_window">
      <field name="name">Taxes</field>
      <field name="res_model">account.tax</field>
      <field name="view_mode">list,form</field>
      <field name="context">{}</field>
    </record>
    <menuitem id="menu_acct_task_taxes"
              name="Taxes"
              action="action_agri_acc_taxes"
              parent="menu_acct_task_config_section"
              sequence="20"
              groups="account.group_account_manager"/>
  </data>
</odoo>