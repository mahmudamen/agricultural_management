<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_production_request_template_list" model="ir.ui.view">
            <field name="name">production.request.template.list</field>
            <field name="model">production.request.template</field>
            <field name="arch" type="xml">
                <list default_order="usage_count desc">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="line_count"/>
                    <field name="total_estimated_cost" widget="monetary" sum="Total Cost"/>
                    <field name="usage_count" string="Used"/>
                    <field name="last_used_date" widget="datetime"/>
                    <field name="last_used_by"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>
        <record id="view_production_request_template_form" model="ir.ui.view">
            <field name="name">production.request.template.form</field>
            <field name="model">production.request.template</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_view_usage_history" string="View Usage History" type="object" class="btn-secondary" invisible="usage_count == 0"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_usage_history" type="object" class="oe_stat_button" icon="fa-history" invisible="usage_count == 0">
                                <field name="usage_count" widget="statinfo" string="Times Used"/>
                            </button>
                        </div>

                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>

                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Template Name"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="active"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="total_estimated_cost" widget="monetary"/>
                                <field name="last_used_date" readonly="1"/>
                                <field name="last_used_by" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Template Lines">
                                <field name="template_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="cost_center_type"/>
                                        <field name="unit_price" widget="monetary"/>
                                        <field name="estimated_cost" widget="monetary" sum="Total"/>
                                        <field name="expense_account" optional="hide"/>
                                        <field name="provision_account" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_production_request_template_line_form" model="ir.ui.view">
            <field name="name">request.template.line.form</field>
            <field name="model">request.template.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="template_id"/>
                                <field name="product_id"/>
                                <field name="description"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="unit_price"/>
                                <field name="estimated_cost"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="cost_center_type"/>
                                <field name="expense_account"/>
                                <field name="provision_account"/>
                            </group>
                        </group>

                        <field name="notes" placeholder="Additional notes..."/>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Template Actions -->
        <record id="action_production_request_template" model="ir.actions.act_window">
            <field name="name">Production Request Templates</field>
            <field name="res_model">production.request.template</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first production request template
                </p>
                <p>
                    Templates help you quickly create production requests with predefined items.
                </p>
            </field>
        </record>
        <!-- Most Used Templates Action -->
        <record id="action_production_request_template_most_used" model="ir.actions.act_window">
            <field name="name">Most Used Templates</field>
            <field name="res_model">production.request.template</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('usage_count', '>=', 0)]</field>
            <field name="context">{'search_default_group_by_usage': 1}</field>
        </record>
        <!-- Menu Items -->
        <menuitem id="menu_production_request_templates_main"
                  name="Production Templates"
                  parent="menu_agricultural_production"
                  action="action_production_request_template"
                  sequence="15"/>
    </data>
</odoo>
