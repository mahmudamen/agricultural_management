<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================== -->
    <!-- Project list View with Cost Buttons for Sections -->
    <!-- ====================================== -->
    <record id="agricultural_project_list_sections_cost_view" model="ir.ui.view">
        <field name="name">agricultural.project.list.sections.cost</field>
        <field name="model">agricultural.project</field>
        <field name="arch" type="xml">
            <list default_order="name" editable="bottom"
                  string="Agricultural Projects - Cost Management"
                  limit="20">
                <!-- Basic Fields -->
 <field name="name" string="Project" required="1"/>
                <field name="code" string="Number Project" optional="show"/>
 <field name="partner_id" string="" optional="show"/>
                <!-- Hidden Fields -->
                <field name="currency_id" invisible="1"/>
                <field name="analytic_account_id" invisible="1"/>
                <field name="allocation_count" invisible="1"/>
                <field name="calculation_count" invisible="1"/>
                <!-- Direct Expenses Button -->
                <button name="action_view_direct_expenses"
                        type="object"
                        string="Direct Expenses"
                        class="btn-primary"
                        icon="fa-industry"
 title="View Expenses Operations Direct - Direct through account balances"/>
                <button name="action_view_indirect_operating_expenses"
                        type="object"
                        string="Indirect Expenses"
                        class="btn-secondary"
                        icon="fa-cogs"
 title="View Expenses Operations Direct - distributed according to ratios"/>
                <button name="action_view_administrative_expenses"
                        type="object"
                        string="Administrative"
                        class="btn-info"
                        icon="fa-building"
 title="View Expenses Administrative - treated as indirect expenses Direct"/>
                <button name="action_view_selling_expenses"
                        type="object"
                        string="Sales"
                        class="btn-warning"
                        icon="fa-truck"
 title="View Expenses Sales"/>
                <button name="action_view_financial_expenses"
                        type="object"
                        string="Financial"
                        class="btn-secondary"
                        icon="fa-bank"
                        title="View Financial Expenses - Interest &amp; Murabaha"/>
                <!-- Cost Allocation Wizard -->
                <button name="action_cost_allocation_wizard"
                        type="object"
 string="Allocation"
                        class="btn-success"
                        icon="fa-calculator"
 title="Cost Allocation"/>
                <button name="action_create_cost_calculation"
                        type="object"
 string=""
                        class="btn-primary"
                        icon="fa-chart-line"
                        title="Create Cost Account New"/>
                <button name="action_view_cost_calculations"
                        type="object"
                        string="Accounts"
                        class="btn-secondary"
                        icon="fa-file-text-o"
 title="View Accounts"/>

            </list>
        </field>
    </record>


    <!-- ====================================== -->
    <!-- Simplified List View for Quick Access -->
    <!-- ====================================== -->
    <record id="agricultural_project_list_sections_simple_view" model="ir.ui.view">
        <field name="name">agricultural.project.list.sections.simple</field>
        <field name="model">agricultural.project</field>
        <field name="arch" type="xml">
            <list default_order="name"
                  string="Projects"
                  decoration-primary="state=='active'"
                  editable="bottom"
                  limit="20">
                <field name="name" string="Project"/>
 <field name="code" string="Number"/>
                <field name="state" widget="badge" readonly="1"/>
                <field name="total_project_cost"
 string=""
                       widget="monetary"
                       readonly="1"
                       sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <!-- Quick Action Buttons -->
                <button name="action_view_all_costs"
                        type="object"
                        string="Costs"
                        class="btn-primary"
                        icon="fa-money"/>
                <button name="action_cost_allocation_wizard"
                        type="object"
                        string="Allocation"
                        class="btn-success"
                        icon="fa-calculator"/>
                <button name="action_cost_summary_dashboard"
                        type="object"
 string="Report"
                        class="btn-info"
                        icon="fa-bar-chart"/>

            </list>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- Pivot View for Cost Analysis from Sections -->
    <!-- ====================================== -->
    <record id="agricultural_project_pivot_sections_cost_view" model="ir.ui.view">
        <field name="name">agricultural.project.pivot.sections.cost</field>
        <field name="model">agricultural.project</field>
        <field name="arch" type="xml">
 <pivot string="Analysis Projects">
                <field name="name" type="row"/>
                <field name="state" type="col"/>
                <field name="total_direct_expenses" type="measure" string="Direct"/>
                <field name="total_indirect_expenses" type="measure" string="Indirect"/>
                <field name="total_admin_expenses" type="measure" string="Administrative"/>
                <field name="total_selling_expenses" type="measure" string="Sales"/>
                <field name="total_financial_expenses" type="measure" string="Financial"/>
                <field name="total_other_expenses" type="measure" string="Other"/>
                <field name="total_project_cost" type="measure" string="Total"/>
            </pivot>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- Graph View for Cost Visualization -->
    <!-- ====================================== -->
    <record id="agricultural_project_graph_sections_cost_view" model="ir.ui.view">
        <field name="name">agricultural.project.graph.sections.cost</field>
        <field name="model">agricultural.project</field>
        <field name="arch" type="xml">
 <graph string="Graph" type="bar" stacked="True">
                <field name="name"/>
                <field name="total_direct_expenses" type="measure" string="Direct"/>
                <field name="total_indirect_expenses" type="measure" string="Indirect"/>
                <field name="total_admin_expenses" type="measure" string="Administrative"/>
                <field name="total_selling_expenses" type="measure" string="Sales"/>
                <field name="total_financial_expenses" type="measure" string="Financial"/>
            </graph>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- Kanban View for Sections -->
    <!-- ====================================== -->
    <record id="agricultural_project_kanban_sections_cost_view" model="ir.ui.view">
        <field name="name">agricultural.project.kanban.sections.cost</field>
        <field name="model">agricultural.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="code"/>
                <field name="state"/>
                <field name="total_project_cost"/>
                <field name="total_direct_expenses"/>
                <field name="total_indirect_expenses"/>
                <field name="currency_id"/>
                <field name="partner_id"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">

                            <!-- Card Header -->
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <br/>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="code"/>
                                    </span>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {
                                           'draft': 'secondary',
                                           'planned': 'info',
                                           'active': 'success',
                                           'completed': 'primary',
                                           'cancelled': 'danger'
                                       }}"/>
                            </div>

                            <!-- Partner Info -->
                            <div class="o_kanban_record_subtitle" t-if="record.partner_id.value">
                                <i class="fa fa-user" title="user"/> <field name="partner_id"/>
                            </div>

                            <!-- Cost Summary -->
                            <div class="o_kanban_record_body mt8">
                                <div class="row g-0 mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Direct:</small>
                                    </div>
                                    <div class="col-6 text-end">
                                        <strong>
                                            <field name="total_direct_expenses" widget="monetary"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="row g-0">
                                    <div class="col-6">
                                        <small class="text-muted">Indirect:</small>
                                    </div>
                                    <div class="col-6 text-end">
                                        <strong>
                                            <field name="total_indirect_expenses" widget="monetary"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="o_kanban_record_body mt-3">
                                <div class="row g-1">
                                    <div class="col-6">
                                        <button name="action_view_direct_expenses"
                                                type="object"
                                                class="btn btn-sm btn-primary w-100">
                                            <i class="fa fa-industry" title="industry"/> Direct
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button name="action_view_indirect_operating_expenses"
                                                type="object"
                                                class="btn btn-sm btn-secondary w-100">
                                            <i class="fa fa-cogs" title="cogs"/> Indirect
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button name="action_view_administrative_expenses"
                                                type="object"
                                                class="btn btn-sm btn-info w-100">
                                            <i class="fa fa-building" title="building"/> Administrative
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button name="action_cost_summary_dashboard"
                                                type="object"
                                                class="btn btn-sm btn-warning w-100">
 <i class="fa fa-dashboard" title="dashboard"/> Report
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Footer -->
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge bg-secondary">
                                        <i class="fa fa-calculator" title="calculator"/> <field name="allocation_count"/>
                                    </span>
                                    <span class="badge bg-info ms-1">
                                        <i class="fa fa-file-text-o" title="file"/> <field name="calculation_count"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong class="text-primary">
                                        <field name="total_project_cost" widget="monetary"/>
                                    </strong>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- Activity View -->
    <!-- ====================================== -->
    <record id="agricultural_project_activity_sections_view" model="ir.ui.view">
        <field name="name">agricultural.project.activity.sections</field>
        <field name="model">agricultural.project</field>
        <field name="arch" type="xml">
            <activity string="Projects">
                <field name="name"/>
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="name" class="o_text_block"/>
                            <field name="code"/>
                        </div>
                        <div>
                            <field name="state" widget="badge"/>
                            <field name="total_project_cost" widget="monetary"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Section Cost Management -->
    <!-- ====================================== -->
    <record id="action_section_projects_cost_management" model="ir.actions.act_window">
        <field name="name">Section Project Cost Management</field>
        <field name="res_model">agricultural.project</field>
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
        <field name="view_id" ref="agricultural_project_list_sections_cost_view"/>
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_filter_with_costs': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Agricultural Project New
            </p>
            <p>
 Management and track all costs Projects including expenses Direct
 Costs Operations Direct Administrative .
            </p>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Direct Expenses Summary -->
    <!-- ====================================== -->
    <record id="action_section_direct_expenses_summary" model="ir.actions.act_window">
        <field name="name">Direct Expenses Summary</field>
        <field name="res_model">agri.cost.allocation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('cost_category', 'in', ['direct_material', 'seeds', 'fertilizers', 'pesticides', 'direct_labor', 'machinery', 'utilities', 'fuel'])]</field>
        <field name="context">{
            'search_default_group_by_project': 1,
            'search_default_group_by_category': 1,
        }</field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Indirect Expenses Summary -->
    <!-- ====================================== -->
    <record id="action_section_indirect_expenses_summary" model="ir.actions.act_window">
        <field name="name">Indirect Expenses Summary</field>
        <field name="res_model">agri.cost.allocation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('cost_category', 'in', ['maintenance', 'overhead'])]</field>
        <field name="context">{
            'search_default_group_by_project': 1,
            'search_default_group_by_category': 1,
        }</field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Administrative Expenses Summary -->
    <!-- ====================================== -->
    <record id="action_section_admin_expenses_summary" model="ir.actions.act_window">
        <field name="name">Administrative Expenses Summary</field>
        <field name="res_model">agri.cost.allocation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('cost_category', 'in', ['depreciation', 'insurance'])]</field>
        <field name="context">{
            'search_default_group_by_project': 1,
            'search_default_group_by_category': 1,
        }</field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Selling Expenses Summary -->
    <!-- ====================================== -->
    <record id="action_section_selling_expenses_summary" model="ir.actions.act_window">
        <field name="name">Selling Expenses Summary</field>
        <field name="res_model">agri.cost.allocation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('cost_category', 'in', ['transportation', 'packaging'])]</field>
        <field name="context">{
            'search_default_group_by_project': 1,
            'search_default_group_by_category': 1,
        }</field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Cost Allocation Lines Dashboard -->
    <!-- ====================================== -->
    <record id="action_section_cost_allocation_lines_dashboard" model="ir.actions.act_window">
        <field name="name">Cost Allocation Dashboard</field>
        <field name="res_model">agri.cost.allocation.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{
            'pivot_measures': ['amount', 'cost_per_m2', 'cost_per_plant'],
            'pivot_column_groupby': ['allocation_date:month'],
            'pivot_row_groupby': ['project_id', 'cost_category'],
            'graph_type': 'bar',
            'graph_measure': 'amount',
            'graph_groupbys': ['project_id', 'cost_category'],
        }</field>
    </record>

    <!-- ====================================== -->
    <!-- Action: Cost Calculations Summary -->
    <!-- ====================================== -->
    <record id="action_section_cost_calculations_summary" model="ir.actions.act_window">
        <field name="name">Cost Calculations Summary</field>
        <field name="res_model">agri.cost.calculation</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{
            'search_default_group_by_period': 1,
        }</field>
    </record>


</odoo>