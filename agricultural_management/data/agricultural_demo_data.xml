    </record>
    <record id="product_pepper" model="product.product">
        <field name="name">Bell Pepper - Grade A</field>
        <field name="type">goods</field>
        <field name="list_price">15.00</field>
        <field name="standard_price">7.00</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
    </record>

</data>
</odoo>