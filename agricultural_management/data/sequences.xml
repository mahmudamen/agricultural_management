<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="seq_harvest_lot" model="ir.sequence">
            <field name="name">Harvest Lot Sequence</field>
            <field name="code">harvest.lot</field>
            <field name="prefix">LOT</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
        <!-- Production Request Sequence -->
        <record id="seq_production_request" model="ir.sequence">
            <field name="name">Production Request</field>
            <field name="code">agricultural.production.request</field>
            <field name="prefix">PR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Warehouse Authorization Sequence -->
        <record id="seq_warehouse_authorization" model="ir.sequence">
            <field name="name">Warehouse Authorization</field>
            <field name="code">warehouse.authorization.request</field>
            <field name="prefix">WA</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_agricultural_farm" model="ir.sequence">
            <field name="name">Agricultural Farm</field>
            <field name="code">agricultural.farm</field>
            <field name="prefix">AF</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_stock_location" model="ir.sequence">
			<field name="name">Stock Location</field>
			<field name="code">stock.location</field>
			<field name="prefix">GH/</field>
			<field eval="1" name="number_next"/>
			<field eval="1" name="number_increment"/>
			<field eval="True" name="use_date_range"/>
			<field eval="1" name="number_next"/>
			<field name="padding">3</field>
			<field name="company_id" eval="False"/>
		</record>
        <record id="sequence_harvest_batch" model="ir.sequence">
            <field name="name">Harvest Batch</field>
            <field name="code">harvest.batch</field>
            <field name="prefix">HB/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_household_harvest" model="ir.sequence">
            <field name="name">Household Harvest</field>
            <field name="code">household.harvest</field>
            <field name="prefix">HH/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_harvest_sorting_line" model="ir.sequence">
            <field name="name">Harvest Sorting Line</field>
            <field name="code">harvest.sorting.line</field>
            <field name="prefix">HSL/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_agricultural_harvest_schedule" model="ir.sequence">
            <field name="name">Agricultural Harvest Schedule</field>
            <field name="code">agricultural.harvest.schedule</field>
            <field name="prefix">Harv</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_agricultural_harvest_lot" model="ir.sequence">
            <field name="name">Production Harvest Lot</field>
            <field name="code">stock.lot</field>
            <field name="prefix">Lot</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
                <!-- Agricultural Project Sequence -->
        <record id="seq_agricultural_project" model="ir.sequence">
            <field name="name">Agricultural Project</field>
            <field name="code">agricultural.project</field>
            <field name="prefix">PROJ-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

